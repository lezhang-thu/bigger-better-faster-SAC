# Stage 2: train only the stopped-latent R2 actor bridge toward the frozen
# real-policy distribution. BBF encoder, Q, actor, and RSSM dynamics are not
# owned by this loss.
BBFAgent.r2_world_model_enabled = True
BBFAgent.r2_control_bridge_enabled = True
BBFAgent.r2_latent_value_enabled = False
BBFAgent.r2_value_q_anchor_weight = 0.0
BBFAgent.r2_bridge_policy_consistency_weight = 1.0
BBFAgent.r2_imag_horizon = 0
BBFAgent.r2_imag_value_weight = 0.0
BBFAgent.r2_imag_actor_weight = 0.0
BBFAgent.r2_imag_actor_grad_scale = 0.0
