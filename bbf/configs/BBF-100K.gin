# SPR (Schwarzer et al, 2021)
import bbf.spr_networks
import bbf.agents.spr_agent
import bbf.replay_memory.subsequence_replay_buffer

JaxDQNAgent.gamma = 0.997
JaxDQNAgent.min_replay_history = 2000
JaxDQNAgent.update_period = 1
JaxDQNAgent.target_update_period = 1
JaxDQNAgent.epsilon_train = 0.00
JaxDQNAgent.epsilon_eval = 0.001
JaxDQNAgent.epsilon_decay_period = 2001    # DrQ
JaxDQNAgent.optimizer = 'adam'

BBFAgent.double_dqn = True
BBFAgent.distributional = True
BBFAgent.num_atoms = 51
BBFAgent.update_horizon = 3
BBFAgent.max_update_horizon = 10
BBFAgent.min_gamma = 0.97
BBFAgent.cycle_steps = 10_000
BBFAgent.reset_every = 20_000 # Change if you change the replay ratio
#BBFAgent.reset_every = 5_000 # Change if you change the replay ratio
BBFAgent.shrink_perturb_keys = "encoder,transition_model"
BBFAgent.shrink_factor = 0.5
BBFAgent.perturb_factor = 0.5
BBFAgent.no_resets_after = 100_000 # Need to change if training longer
BBFAgent.log_every = 100
BBFAgent.replay_ratio = 64
#BBFAgent.replay_ratio = 256
# Late-phase update multiplier (off by default). late_update_after is in env
# steps like reset_every; from it onwards the agent runs
# late_update_multiplier x the update phases per env step, i.e. a higher
# effective replay ratio for the tail of the run only. Note the coupling: the
# gin default schedule resets at 20k/40k/60k and skips 80k (needs 20_000 env
# steps of recovery before no_resets_after), so the final phase is already
# 40k env steps = 80k grad steps, twice the 40k-grad reset cycle. Doubling
# updates there without also shortening reset_every makes it 160k grad steps
# in one un-reset stretch.
BBFAgent.late_update_after = -1
BBFAgent.late_update_multiplier = 1
BBFAgent.batches_to_group = 2
BBFAgent.batch_size = 32
BBFAgent.spr_weight = 5

# Depth of the learned model. SPR is the only thing that supervises the
# transition model, and it does so out to exactly this many steps (as do the
# reward and continue heads, which train on the SPR rollout features), so
# imagination must not roll out deeper than this -- past it, the latents are
# extrapolating into a regime nothing ever trained them on. Tied rather than
# set twice: overriding MODEL_HORIZON moves both.
MODEL_HORIZON = 5
BBFAgent.jumps = %MODEL_HORIZON

# World-model heads and imagination (r2dreamer-style, on the SPR model).
BBFAgent.reward_weight = 1.0
BBFAgent.continue_weight = 1.0
# Grounding-gradient surgery (PCGrad on one loss): project out the component
# of the reward/continue gradient that conflicts with the TD+SPR direction
# at the shared encoder/TM -- the soft alternative to the all-or-nothing
# reward_readout (only meaningful when reward_readout=False). Costs a second
# backward pass when enabled. Logs GroundCos (conflict cosine).
BBFAgent.reward_grad_surgery = False
BBFAgent.imag_horizon = %MODEL_HORIZON
BBFAgent.imag_actor_weight = .1
# Model-generated lambda-return targets into the online critic: keep small.
# ~2% of the critic objective after PER weighting; raise only if the gate
# games (Kangaroo/Hero/Jamesbond + ChopperCommand) stay healthy.
BBFAgent.imag_value_weight = 0.05
# Trust region for the imagined critic targets: bound the lambda-return
# within imag_value_trust * return-scale of the target critic's estimate for
# the taken action (None = off, unbounded). Actor advantages are untouched.
# Aimed at the model-confident-but-wrong target class (Gopher/Jamesbond).
# Logs ImagTrustClip (fraction of targets hitting the bound).
BBFAgent.imag_value_trust = None
BBFAgent.imag_lambda = 0.95
BBFAgent.imag_warmup = 2000
# Imagination entropy: keep it coupled to the annealed x_ent_coef
# (0.01 -> 0 over the first 80k env steps). Decoupling was tried twice and
# failed with a clean dose-response on Pong (refs 17.41-20.41): fixed 3e-4
# replacement -> 11.54; max(x_ent_coef, 3e-4) late-only floor -> 14.11
# (Gopher 582.8, below baseline min). The anneal-to-zero is load-bearing in
# imagination as well as replay; a float here overrides it as an ablation
# only.
BBFAgent.imag_entropy_weight = None

BBFAgent.data_augmentation = True
BBFAgent.half_precision = False
BBFAgent.network    = @bbf.spr_networks.RainbowDQNNetwork
#BBFAgent.epsilon_fn = @jax.agents.dqn.dqn_agent.linearly_decaying_epsilon
BBFAgent.learning_rate = 0.0001
BBFAgent.encoder_learning_rate = 0.0001

BBFAgent.target_update_tau = 0.005
BBFAgent.target_action_selection = True

bbf.spr_networks.RainbowDQNNetwork.renormalize = True
bbf.spr_networks.RainbowDQNNetwork.hidden_dim = 2048
bbf.spr_networks.RainbowDQNNetwork.width_scale = 4
bbf.spr_networks.ImpalaCNN.num_blocks = 2

# Note these parameters are from DER (van Hasselt et al, 2019)
bbf.agents.spr_agent.create_scaling_optimizer.eps = 0.00015
bbf.agents.spr_agent.create_scaling_optimizer.weight_decay = 0.1

#DataEfficientAtariRunner.game_name = 'Alien'
DataEfficientAtariRunner.game_name = 'Jamesbond'
# Atari 100K benchmark doesn't use sticky actions.
create_atari_environment.sticky_actions = False
AtariPreprocessing.terminal_on_life_loss = True
Runner.num_iterations = 1
#Runner.training_steps = 100000    # agent steps
Runner.training_steps = 100_000    # agent steps
DataEfficientAtariRunner.num_eval_episodes = 100    # agent episodes
DataEfficientAtariRunner.num_eval_envs = 100    # agent episodes
DataEfficientAtariRunner.num_train_envs = 1    # agent episodes
DataEfficientAtariRunner.max_noops = 30
Runner.max_steps_per_episode = 27000    # agent steps

bbf.replay_memory.subsequence_replay_buffer.PrioritizedJaxSubsequenceParallelEnvReplayBuffer.replay_capacity = 200000
bbf.replay_memory.subsequence_replay_buffer.PrioritizedJaxSubsequenceParallelEnvReplayBuffer.n_envs = 1    # agent episodes
bbf.replay_memory.subsequence_replay_buffer.JaxSubsequenceParallelEnvReplayBuffer.replay_capacity = 10000
bbf.replay_memory.subsequence_replay_buffer.JaxSubsequenceParallelEnvReplayBuffer.n_envs = 1    # agent episodes
